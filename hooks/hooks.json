{
  "description": "Protect resumability only when SCD Dev Loop fallback state is active.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-state.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\check-state.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking SCD Dev Loop continuity state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-state.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\check-state.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking SCD Dev Loop continuity state"
          }
        ]
      }
    ]
  }
}
