{
  "description": "Restore SCD continuity context after ZCode compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/check-state.mjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "Checking SCD continuity state"
          }
        ]
      }
    ]
  }
}
