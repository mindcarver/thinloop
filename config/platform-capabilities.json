{
  "schemaVersion": 1,
  "product": {
    "name": "thinloop",
    "versionManifest": ".codex-plugin/plugin.json",
    "skillsRoot": "skills"
  },
  "platforms": [
    {
      "id": "codex",
      "displayName": "Codex",
      "installation": {
        "mode": "skill-links",
        "skillRoot": ".codex/skills",
        "skillRootOverride": {
          "environment": "CODEX_HOME",
          "suffix": "skills"
        },
        "summary": "把十二个 Skill 链接到 `~/.codex/skills`",
        "takesEffect": "新任务"
      },
      "capabilities": {
        "hooks": []
      },
      "verification": {
        "mode": "skill-links",
        "summary": "十二个链接都能读取 `SKILL.md`；新任务可发现 `$scd-next`、`$scd-execute`、`$scd-project` 与 `$scd-quickdev`"
      }
    },
    {
      "id": "opencode",
      "displayName": "OpenCode",
      "installation": {
        "mode": "skill-links",
        "skillRoot": ".config/opencode/skills",
        "skillRootOverride": {
          "environment": "XDG_CONFIG_HOME",
          "suffix": "opencode/skills"
        },
        "summary": "把十二个 Skill 链接到 `~/.config/opencode/skills`",
        "takesEffect": "重启 OpenCode"
      },
      "capabilities": {
        "hooks": []
      },
      "verification": {
        "mode": "skill-links",
        "summary": "十二个 Skill 链接均指向当前源码；运行时需确认 `scd-next`、`scd-execute`、`scd-project` 与其他 Skill 均被发现",
        "manualRuntime": {
          "command": [
            "opencode",
            "debug",
            "skill"
          ],
          "checkerEligible": false,
          "summary": "需要核对运行时发现时手动执行；该命令会启动 OpenCode 并可能写入日志"
        }
      }
    },
    {
      "id": "pi",
      "displayName": "Pi",
      "installation": {
        "mode": "skill-links",
        "skillRoot": ".pi/agent/skills",
        "skillRootOverride": {
          "environment": "PI_CODING_AGENT_DIR",
          "suffix": "skills"
        },
        "summary": "把十二个 Skill 链接到 `~/.pi/agent/skills`",
        "takesEffect": "新会话或执行 `/reload`"
      },
      "capabilities": {
        "hooks": []
      },
      "verification": {
        "mode": "skill-links",
        "summary": "十二个 Skill 链接均指向当前源码；Pi RPC `get_commands` 可发现十二个 `/skill:scd-*` 命令"
      }
    },
    {
      "id": "codewhale",
      "displayName": "CodeWhale",
      "installation": {
        "mode": "skill-links",
        "skillRoot": ".codewhale/skills",
        "skillRootOverride": {
          "environment": "CODEWHALE_SKILLS_DIR",
          "direct": true
        },
        "summary": "把十二个 Skill 链接到 `~/.codewhale/skills`",
        "takesEffect": "新会话"
      },
      "capabilities": {
        "hooks": []
      },
      "verification": {
        "mode": "skill-links",
        "summary": "十二个 Skill 链接均指向当前源码；`codewhale doctor --json` 确认全局 Skill 根、数量且跳过实时 API 探测",
        "runtimeDiscovery": {
          "command": [
            "codewhale",
            "doctor",
            "--json"
          ],
          "checkerEligible": true
        }
      }
    },
    {
      "id": "reasonix",
      "displayName": "Reasonix",
      "installation": {
        "mode": "skill-links",
        "skillRoot": ".reasonix/skills",
        "summary": "把十二个 Skill 链接到 `~/.reasonix/skills`",
        "takesEffect": "新会话"
      },
      "capabilities": {
        "hooks": []
      },
      "verification": {
        "mode": "skill-links",
        "summary": "十二个 Skill 链接均指向当前源码；新会话可通过 `/scd-next`、`/scd-execute`、`/scd-project` 与 `/scd-quickdev` 调用"
      }
    },
    {
      "id": "dsh",
      "displayName": "DeepSeek Harness",
      "installation": {
        "mode": "skill-links",
        "skillRoot": ".dsh/skills",
        "skillRootOverride": {
          "environment": "DSH_HOME",
          "suffix": "skills"
        },
        "summary": "把十二个 Skill 链接到 `~/.dsh/skills`",
        "takesEffect": "新会话（filesystem provider 的 watcher 会自动失效并更新目录）"
      },
      "capabilities": {
        "hookHandler": ".dsh-plugin/continuity.mjs",
        "hooks": [
          {
            "event": "agent/turn-stopping",
            "source": ".dsh-plugin/continuity.mjs",
            "kind": "cordis-plugin"
          }
        ]
      },
      "verification": {
        "mode": "skill-links",
        "summary": "十二个 Skill 链接均指向当前源码；新会话的 skill 工具可发现 `scd-next`、`scd-execute`、`scd-project` 与 `scd-quickdev`"
      }
    },
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "installation": {
        "mode": "plugin",
        "manifest": ".claude-plugin/plugin.json",
        "skillRoot": "skills",
        "summary": "安装完整插件",
        "takesEffect": "更新后重启或重新加载插件"
      },
      "capabilities": {
        "hookHandler": "hooks/check-state.mjs",
        "hooks": [
          {
            "event": "PreCompact",
            "source": "hooks/hooks.claude.json"
          },
          {
            "event": "Stop",
            "source": "hooks/hooks.claude.json"
          }
        ]
      },
      "verification": {
        "mode": "plugin-cli",
        "command": [
          "claude",
          "plugin",
          "list",
          "--json"
        ],
        "pluginId": "thinloop@thinloop",
        "summary": "`claude plugin list --json` 提供版本、enabled 与安装路径；检查器从该路径核对十二个 Skill 和两个 Hook，包括 `scd-next` 与 `scd-execute`",
        "manualFallback": "Claude Code 插件页显示 thinloop 已启用"
      }
    },
    {
      "id": "workbuddy",
      "displayName": "WorkBuddy",
      "installation": {
        "mode": "plugin",
        "manifest": ".codebuddy-plugin/plugin.json",
        "skillRoot": "skills",
        "summary": "安装完整插件",
        "takesEffect": "更新后重启 WorkBuddy"
      },
      "capabilities": {
        "hookHandler": "hooks/check-state.mjs",
        "hooks": [
          {
            "event": "PreCompact",
            "source": "hooks/hooks.workbuddy.json"
          },
          {
            "event": "Stop",
            "source": "hooks/hooks.workbuddy.json"
          }
        ]
      },
      "verification": {
        "mode": "manual",
        "pluginId": "thinloop@thinloop",
        "summary": "插件页显示当前仓库版本、enabled、十二个 Skill 和两个 Hook，包括 `scd-next` 与 `scd-execute`",
        "manualFallback": "`codebuddy plugin list --json` 会写客户端日志；必须在 WorkBuddy 插件页核验"
      }
    },
    {
      "id": "zcode",
      "displayName": "ZCode",
      "installation": {
        "mode": "plugin",
        "manifest": ".zcode-plugin/plugin.json",
        "skillRoot": "skills",
        "summary": "安装完整插件",
        "takesEffect": "更新后新建会话"
      },
      "capabilities": {
        "hookHandler": "hooks/check-state.mjs",
        "hooks": [
          {
            "event": "SessionStart",
            "matcher": "compact",
            "source": "hooks/hooks.zcode.json"
          },
          {
            "event": "Stop",
            "source": "hooks/hooks.json"
          }
        ]
      },
      "verification": {
        "mode": "manual",
        "summary": "Settings → Plugins 显示当前仓库版本、12 Skills、2 Hooks；Skills 中存在 `scd-next`、`scd-execute`、`scd-project` 与 `scd-quickdev`",
        "manualFallback": "ZCode 当前没有可依赖的 CLI；必须在 Settings → Plugins 中核验"
      }
    }
  ]
}
